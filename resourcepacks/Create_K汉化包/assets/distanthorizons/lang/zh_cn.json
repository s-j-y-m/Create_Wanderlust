  "distanthorizons.config.client.advanced.graphics.experimental.earthCurveRatio.@tooltip": "值为 1 相当于现实生活中的地球曲率。\n最小可接受值为 50，最大值为 5000。\n介于 1 到 49 之间的所有值都将向上舍入为 50。",

  "distanthorizons.config.client.advanced.autoUpdater": "自动更新器",

  "distanthorizons.config.client.advanced.autoUpdater.enableAutoUpdater": "启用自动更新",
